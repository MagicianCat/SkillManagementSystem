# 本地启动后端所需配置。复制为 .env 后填写，不要提交 .env。
DB_PASSWORD=
JWT_SIGNING_KEY=
MINIO_SECRET_KEY=

FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
FEISHU_MOCK_HTTPS_ENABLED=false
FEISHU_MOCK_HTTPS_BASE_URL=
# 必须是可 Base64 解码为 32 字节的固定值
FEISHU_TOKEN_ENCRYPTION_KEY=
# ASDM GitLab integration is opt-in. Use an independent base64 key from FEISHU_TOKEN_ENCRYPTION_KEY.
ASDM_GITLAB_ENABLED=false
ASDM_GITLAB_ALLOWED_HOSTS=jihulab.com
ASDM_GITLAB_TOKEN_ENCRYPTION_KEY=
ASDM_GITLAB_POLL_INTERVAL=60s
ASDM_GITLAB_DEBOUNCE=300s
ASDM_GITLAB_HTTP_CONNECT_TIMEOUT=5s
ASDM_GITLAB_HTTP_READ_TIMEOUT=20s
ASDM_GITLAB_MAX_MARKDOWN_BYTES=1048576
ASDM_GITLAB_MAX_TREE_ENTRIES=5000
ASDM_GITLAB_POLL_BATCH_SIZE=20
ASDM_MULTI_STAGE_ENABLED=false
ASDM_MULTI_FILE_PUBLISH_ENABLED=false
ASDM_MAX_DISCOVERY_ENTRIES=20000
ASDM_MAX_CANDIDATE_FILES=300
ASDM_MAX_FILE_BYTES=20971520
ASDM_MAX_PACKAGE_BYTES=209715200
ASDM_MATCH_LIKELY_AUTOINCLUDE=false
ASDM_FILE_PUBLISH_WORKERS=4
ASDM_FILE_PUBLISH_RETRY_LIMIT=8
ASDM_BLOB_CACHE_TTL=24h
# 遥测身份快照和对话对象的 AES-GCM 密钥，必须是可 Base64 解码为 32 字节的固定值
SKILL_USAGE_ENCRYPTION_KEY=
FEISHU_EVENT_ENABLED=true
FEISHU_BOT_ENABLED=true
DSH_SERVICE_TOKEN=local-dsh-service-token

# Wiki knowledge retrieval. Keep real model credentials only in .env.
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=wiki_chunks_v1
KB_EMBEDDING_URL=https://tkcopilot.taikang.com/v1/tongyi/embeddings
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=qwen3-embedding-0.6b
KB_EMBEDDING_DIMENSIONS=1024
KB_RERANK_ENABLED=true
KB_RERANK_URL=https://tkcopilot.taikang.com/v1/tongyi/rerank
KB_RERANK_API_KEY=
KB_RERANK_MODEL=qwen3-reranker-0.6b

# Public frontend URL for ASDM tool download links (include deployment subpath if applicable)
ASDM_TOOL_DOWNLOAD_BASE_URL=
ASDM_TOOL_MAX_INNER_ZIP_BYTES=52428800
